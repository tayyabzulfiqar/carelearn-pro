{
  "name": "carelearn-pro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "web:prebuild": "npm run prebuild --workspace @carelearn/web",
    "web:build": "npm run build --workspace @carelearn/web",
    "web:verify": "npm run web:prebuild && npm run web:build",
    "fire-safety:import": "node apps/api/src/scripts/import-fire-safety-course.js",
    "fire-safety:validate": "node apps/api/src/scripts/validate-fire-safety-system.js",
    "fire-safety:test": "node --test apps/api/src/lib/fire-safety-quiz.test.js apps/web/src/lib/quizSession.test.js apps/web/src/lib/coursePlayerState.test.js",
    "recovery:publish": "node apps/api/src/scripts/publish-recovery-course.js",
    "recovery:verify": "node scripts/production/verify-recovery-course.js",
    "recovery:test": "node --test apps/api/src/lib/recovery-package-converter.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.54.2"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "node-fetch": "^3.3.2",
    "ssh2": "^1.17.0"
  }
}
